    "source": "results/empty_contact_tetrahedra.json",
    "source_count": 37,
    "scope": "ACMS tetrahedral inscribed-contact branch; class ids index source classes",
    "lattice": "Z^3",
    "method": "independent exact barycentric gauge of P-P; pure rational arithmetic",
    "simplex_form": "P=conv(0,(N,1,a),e2,e3), B=[[N,0,0],[1,1,0],[a,0,1]]",
    "gauge_formula": "gamma(q)=max(sum_i max(q_i,0),sum_i max(-q_i,0)); ell=min_{z in Z^3\\{0}} gamma(B^{-1}z)",
    "residue_formula": "for N>1, ell=(1/N) min_{1<=k<N}(d_N(k)+d_N(a*k mod N)), d_N(r)=min(r,N-r); N=1 gives ell=1",
    "finite_certificate": "gamma(q)<=ell<=1 implies |q_i|<=ell; enumerate x,y,z with |x|<=m, |N*y-x|<=m, |N*z-a*x|<=m, where ell=m/N",
    "alpha_expression": "1-(1+2/sqrt(3))/(2+sqrt(2))",
    "alpha_interval": "(0.368902823735021962,0.368902823735022342)",
    "w0": "2+sqrt(2)",
    "strong_thresholds": {
      "lambda1_gt_1_3_if_width_gt": "(3/2)*(1+2/sqrt(3))=3/2+sqrt(3)",
      "lambda1_gt_4_11_if_width_gt": "(11/7)*(1+2/sqrt(3))"
    },
    "diamond_bound": "For the rank-two congruence lattice, Minkowski's planar diamond gives ell<=sqrt(2/N), hence ell>=alpha implies N<=14 because sqrt(2/15)<alpha.",
    "diamond_bound_orbit_free_check": "White width-one form puts D>1 tetrahedra in 2+2 consecutive layers; the zero-layer section is conv(+-u,+-w) of area 2D, giving the same bound by planar Minkowski."
  },
